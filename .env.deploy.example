# .env.deploy.example — Template de credenciais de deploy
#
# COPIAR para .env.deploy e preencher:
#   cp .env.deploy.example .env.deploy
#
# ATENÇÃO:
# - .env.deploy está no .gitignore (NÃO COMMITE)
# - Credenciais reais devem ficar APENAS no seu .env.deploy local
# - Em produção real, use GitHub Secrets, Vault, ou outro secret manager

# === Deploy config (filtrado antes de upload para VPS) ===
VPS_HOST=
VPS_USER=root
VPS_PASSWORD=
VPS_PROJECT_DIR=/opt/freela-food
GIT_REPO=https://github.com/LufeDigitalWave/freela-food.git
COMPOSE_FILE=docker-compose.deploy.yml

# === Runtime config (vai pro .env na VPS) ===
ENV=prod
LOG_LEVEL=INFO

# Database — use hostname interno Docker, NÃO IP externo
# Swarm services: freela_food_postgres, freela_food_redis, freela_food_minio
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@freela_food_postgres:5432/DBNAME
DB_ENCRYPTION_KEY=

# Redis
REDIS_URL=redis://:PASSWORD@freela_food_redis:6379/0

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Bcrypt
BCRYPT_ROUNDS=12

# S3 / MinIO
S3_ENDPOINT_URL=http://freela_food_minio:9000
S3_REGION=us-east-1
S3_BUCKET=freela-food-uploads
S3_PUBLIC_BASE_URL=http://YOUR_VPS_IP:9000/freela-food-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# CORS — domínios permitidos (separados por vírgula)
CORS_ORIGINS=http://YOUR_VPS_IP,https://yourdomain.com

# LGPD
DELETE_GRACE_PERIOD_DAYS=30

# Auth
REFRESH_TOKEN_EXPIRE_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Rate limit
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_DEFAULT=60

# Password policy
PASSWORD_MIN_LENGTH=8

# Matching engine (somam ~1.0)
MATCH_WEIGHT_PROXIMITY=0.25
MATCH_WEIGHT_SKILL=0.20
MATCH_WEIGHT_RATING=0.20
MATCH_WEIGHT_RELIABILITY=0.15
MATCH_WEIGHT_EXPERIENCE=0.10
MATCH_WEIGHT_REPEAT_HIRE=0.10

# Sentry (deixe vazio para desabilitar)
SENTRY_DSN=
